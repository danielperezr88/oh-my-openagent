  "stateMachines": [
    {
      "name": "Consolidation Pipeline",
      "description": "The 2-phase agent-driven consolidation flow. Doc-store provides context and schema; the LLM agent performs extraction, reasoning, and structuring.",
      "states": [
        {
          "id": "pending",
          "label": "PENDING",
          "description": "Document has been ingested and is waiting for consolidation."
        },
        {
          "id": "discovered",
          "label": "DISCOVERED",
          "description": "Agent ran consolidate_list and found the pending document."
        },
        {
          "id": "preparing",
          "label": "PREPARING",
          "description": "Agent called consolidate_prepare. Doc-store extracts text and returns schema."
        },
        {
          "id": "awaiting_agent",
          "label": "AWAITING_AGENT",
          "description": "Schema and document text returned to agent. Agent must reason over the text and produce valid JSON matching the schema (1-5 knowledge items with title, category, summary, key_insights, tags, relationships)."
        },
        {
          "id": "validating",
          "label": "VALIDATING",
          "description": "Agent submitted JSON via consolidate_store. Doc-store validates against schema."
        },
        {
          "id": "consolidated",
          "label": "CONSOLIDATED",
          "description": "Validation passed. Knowledge items are persisted with relationships. Success."
        },
        {
          "id": "validation_error",
          "label": "VALIDATION_ERROR",
          "description": "JSON failed validation. Error describes what to fix. Agent must correct and retry."
        }
      ],
      "transitions": [
        {
          "from": "pending",
          "to": "discovered",
          "label": "consolidate_list",
          "trigger": "doc_store_consolidate_list"
        },
        {
          "from": "discovered",
          "to": "preparing",
          "label": "consolidate_prepare",
          "trigger": "doc_store_consolidate_prepare"
        },
        {
          "from": "preparing",
          "to": "awaiting_agent",
          "label": "returns schema + doc_text",
          "trigger": "CLI response"
        },
        {
          "from": "awaiting_agent",
          "to": "validating",
          "label": "agent produces JSON",
          "trigger": "doc_store_consolidate_store"
        },
        {
          "from": "validating",
          "to": "consolidated",
          "label": "validation passes",
          "trigger": "success"
        },
        {
          "from": "validating",
          "to": "validation_error",
          "label": "validation fails",
          "trigger": "validation_error"
        },
        {
          "from": "validation_error",
          "to": "awaiting_agent",
          "label": "agent fixes JSON + retries",
          "trigger": "doc_store_consolidate_store",
          "isRetry": true
        }
      ]
    },
    {
      "name": "Agent Doc-Store Lifecycle",
      "description": "How agents integrate doc-store into their workflow. Before-work (search/query), primary task, after-work (ingest/consolidate).",
      "states": [
        {
          "id": "start",
          "label": "START",
          "description": "Agent receives a task."
        },
        {
          "id": "check_existing",
          "label": "CHECK_EXISTING",
          "description": "Search/query doc-store for existing knowledge on the topic."
        },
        {
          "id": "primary_work",
          "label": "PRIMARY_WORK",
          "description": "Agent performs its main task (research, code, review, etc.)."
        },
        {
          "id": "ingest_sources",
          "label": "INGEST_SOURCES",
          "description": "Save useful raw sources to vault via doc_store_ingest."
        },
        {
          "id": "find_pending",
          "label": "FIND_PENDING",
          "description": "Run consolidate_list to find docs needing consolidation."
        },
        {
          "id": "consolidate_loop",
          "label": "CONSOLIDATE_LOOP",
          "description": "For each pending doc: prepare → produce JSON → store (with retry)."
        },
        {
          "id": "complete",
          "label": "COMPLETE",
          "description": "All done. Knowledge persisted in vault."
        }
      ],
      "transitions": [
        {
          "from": "start",
          "to": "check_existing",
          "label": "search/query",
          "trigger": "doc_store_search / doc_store_query"
        },
        {
          "from": "check_existing",
          "to": "primary_work",
          "label": "existing knowledge incorporated",
          "trigger": "agent decision"
        },
        {
          "from": "primary_work",
          "to": "ingest_sources",
          "label": "save sources",
          "trigger": "doc_store_ingest"
        },
        {
          "from": "ingest_sources",
          "to": "find_pending",
          "label": "check for pending",
          "trigger": "doc_store_consolidate_list"
        },
        {
          "from": "find_pending",
          "to": "consolidate_loop",
          "label": "pending docs found",
          "trigger": "pending_docs.length > 0"
        },
        {
          "from": "consolidate_loop",
          "to": "complete",
          "label": "all docs consolidated",
          "trigger": "all done"
        },
        {
          "from": "find_pending",
          "to": "complete",
          "label": "no pending docs",
          "trigger": "pending_docs.length === 0"
        }
      ]
    }
